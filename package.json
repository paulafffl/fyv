{
    "name": "fyv",
    "version": "0.1.0",
    "private": true,
    "engines": {
        "node": "^24.22.0",
        "npm": ">=11 <12"
    },
    "packageManager": "npm@11.19.1",
    "scripts": {
        "postinstall": "node scripts/patch-minimatch.cjs",
        "start": "vite --host 127.0.0.1 --port 3000",
        "build": "vite build",
        "preview": "vite preview",
        "deploy": "npm run build && firebase deploy --only hosting",
        "lint": "eslint . --max-warnings=0",
        "test": "npm run test:e2e",
        "test:e2e": "playwright test --project=chromium --project=mobile-chromium",
        "test:e2e:all": "playwright test",
        "test:e2e:ui": "playwright test --ui --project=chromium --project=mobile-chromium",
        "test:e2e:report": "playwright show-report",
        "test:cli": "node --test tests/*.test.cjs",
        "test:parity:prepare": "node scripts/prepare-parity-baseline.mjs",
        "test:parity": "playwright test --config playwright.parity.config.cjs --project=chromium-desktop --project=chromium-compact --project=chromium-mobile",
        "test:parity:all": "playwright test --config playwright.parity.config.cjs",
        "test:parity:report": "playwright show-report parity-report"
    },
    "dependencies": {
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-router-dom": "^7.18.5"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.64.1",
        "@vitejs/plugin-legacy": "8.2.3",
        "@vitejs/plugin-react": "^6.1.2",
        "autoprefixer": "10.6.2",
        "eslint": "^10.13.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "firebase-tools": "^15.34.2",
        "globals": "^17.13.0",
        "sass": "^1.107.0",
        "terser": "5.51.2",
        "vite": "^8.3.6"
    },
    "overrides": {
        "@google-cloud/pubsub": {
            "@opentelemetry/core": "2.8.0"
        },
        "gaxios@6": {
            "uuid": "11.1.1"
        },
        "glob@10": "14.0.3",
        "minimatch": "11.0.3"
    }
}
